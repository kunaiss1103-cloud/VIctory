name: Build

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Show toolchain
        run: |
          rustup show
          cargo --version

      - name: Build release
        run: cargo build --release -p victory

      - name: Build diag
        run: cargo build --profile diag -p victory --features diagnostics

      - uses: actions/upload-artifact@v4
        with:
          name: victory-windows
          path: |
            target/release/victory.exe
            target/diag/victory.exe
            victory.example.toml
